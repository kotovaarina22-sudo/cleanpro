<Page x:Class="CleanPro.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет — CleanPro">
    <!-- Личный кабинет: карточка роли/статуса, поля профиля и кнопки внизу -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="460" Margin="20">
                <TextBlock Text="Личный кабинет" Style="{StaticResource FormTitle}"
                           HorizontalAlignment="Center"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Роль" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="txtRole" FontWeight="Bold" Margin="0,0,8,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Статус" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="txtStatus" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Фамилия *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtLastName"/>

                <TextBlock Text="Имя *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtFirstName"/>

                <TextBlock Text="Логин *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtLogin"/>

                <TextBlock Text="Email *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtEmail"/>

                <TextBlock Text="Телефон *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtPhone"/>

                <TextBlock Text="Адрес" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtAddress"/>

                <TextBlock x:Name="txtError" Foreground="{StaticResource WarningColor}"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,6"/>
            </StackPanel>
        </ScrollViewer>

        <!-- снизу: по центру сохранение, справа назад -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Сохранить" Click="Save_Click"
                    HorizontalAlignment="Center"/>

            <Button Grid.Column="2" Content="Назад" Click="Back_Click"
                    HorizontalAlignment="Right" Style="{StaticResource BtnSecondary}"/>
        </Grid>
    </Grid>
</Page>