<Page x:Class="CleanPro.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина — CleanPro">
    <!-- Корзина: таблица позиций, итог, форма оформления заказа и кнопки внизу -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Корзина" FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,6"/>

        <ListView x:Name="listCart" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Услуга" Width="300"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Цена за единицу" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}"/>
                                    <TextBlock Text="{Binding UnitName}"
                                               Foreground="{StaticResource MutedColor}"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Количество" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="70" Margin="2"
                                             Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="Qty_Changed"/>
                                    <TextBlock Text="{Binding UnitName}"
                                               Foreground="{StaticResource MutedColor}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Сумма" Width="120"
                                    DisplayMemberBinding="{Binding Sum, StringFormat={}{0:N2} ₽}"/>
                    <GridViewColumn Header="" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Убрать" Padding="8,3" MinWidth="0"
                                        Margin="0" Background="{StaticResource WarningColor}"
                                        Click="Remove_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="txtTotal" Grid.Row="2" FontSize="17" FontWeight="Bold"
                   HorizontalAlignment="Right" Margin="0,8,0,0"/>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="4,10,4,4">
            <StackPanel>
                <TextBlock Text="Оформление заказа" FontWeight="Bold" FontSize="15"
                           Margin="0,0,0,6"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Адрес *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtAddress"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Дата выполнения *" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="dtDate"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Комментарий" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtComment"/>
            </StackPanel>
        </Border>

        <!-- снизу: слева ошибка, по центру оформление, справа отмена/назад -->
        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtError" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{StaticResource WarningColor}" TextWrapping="Wrap"/>

            <Button x:Name="btnCheckout" Grid.Column="1" Content="Оформить заказ"
                    Click="Checkout_Click" HorizontalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Очистить" Click="Clear_Click"
                        Style="{StaticResource BtnSecondary}"/>
                <Button Content="Назад" Click="Back_Click"
                        Style="{StaticResource BtnSecondary}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>