<Page x:Class="CleanPro.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои заказы — CleanPro">
    <!-- Список заказов пользователя, панель деталей выбранного заказа и его услуг -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle" Grid.Row="0" FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,6"/>

        <ListView x:Name="listOrders" Grid.Row="1"
                  SelectionChanged="Orders_Changed">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Номер" Width="130"
                                    DisplayMemberBinding="{Binding OrderNumber}"/>
                    <GridViewColumn Header="Создан" Width="120"
                                    DisplayMemberBinding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                    <GridViewColumn Header="Выполнение" Width="130"
                                    DisplayMemberBinding="{Binding ScheduledDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                    <GridViewColumn Header="Статус" Width="120"
                                    DisplayMemberBinding="{Binding StatusName}"/>
                    <GridViewColumn Header="Сумма" Width="120"
                                    DisplayMemberBinding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}"/>
                    <GridViewColumn Header="Адрес" Width="280"
                                    DisplayMemberBinding="{Binding TargetAddress}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Детали заказа" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtDetails" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Услуги в заказе" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListView x:Name="listItems" MaxHeight="180"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Услуга" Width="300"
                                                DisplayMemberBinding="{Binding ServiceName}"/>
                                <GridViewColumn Header="Кол-во" Width="90"
                                                DisplayMemberBinding="{Binding Quantity}"/>
                                <GridViewColumn Header="Сумма" Width="120"
                                                DisplayMemberBinding="{Binding FinalPrice, StringFormat={}{0:N2} ₽}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>

        <!-- снизу: слева информация, справа кнопка в каталог -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtInfo" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedColor}"/>

            <Button Grid.Column="2" Content="Каталог" Click="Back_Click"
                    HorizontalAlignment="Right" Style="{StaticResource BtnSecondary}"/>
        </Grid>
    </Grid>
</Page>