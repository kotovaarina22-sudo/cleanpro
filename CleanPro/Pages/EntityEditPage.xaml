<Page x:Class="CleanPro.Pages.EntityEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Изменение записи — CleanPro">
    <!-- Форма записи: заголовок, поля (создаются кодом), кнопки сохранить/отмена -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle" Grid.Row="0" Style="{StaticResource FormTitle}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="formPanel" MaxWidth="640" HorizontalAlignment="Left"/>
        </ScrollViewer>

        <!-- снизу: по центру сохранение, справа отмена -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnSave" Grid.Column="1" Content="Сохранить" Click="Save_Click"
                    HorizontalAlignment="Center"/>

            <Button Grid.Column="2" Content="Отмена" Click="Cancel_Click"
                    HorizontalAlignment="Right" Style="{StaticResource BtnSecondary}"/>
        </Grid>
    </Grid>
</Page>