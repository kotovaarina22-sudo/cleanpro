<Page x:Class="CleanPro.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация — CleanPro">
    <!-- Страница регистрации: поля новой учётной записи, сообщение об ошибке и кнопки внизу -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="420" Margin="20,20,20,0">
                <Image Source="/Images/logo.png" Height="76" Stretch="Uniform"
                       Margin="0,0,0,8"/>
                <TextBlock Text="Регистрация" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Роль по умолчанию — Пользователь" HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedColor}" Margin="0,0,0,14"/>

                <TextBlock Text="Фамилия *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtLastName"/>

                <TextBlock Text="Имя *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtFirstName"/>

                <TextBlock Text="Логин *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtLogin"/>

                <TextBlock Text="Email *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtEmail"/>

                <TextBlock Text="Телефон * (например +79991234567)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtPhone"/>

                <TextBlock Text="Пароль * (от 6 символов)" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="txtPassword"/>

                <TextBlock Text="Повторите пароль *" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="txtPassword2"/>

                <TextBlock Text="Адрес" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtAddress"/>

                <TextBlock x:Name="txtError" Foreground="{StaticResource WarningColor}"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,6"/>
            </StackPanel>
        </ScrollViewer>

        <!-- снизу: по центру регистрация, справа назад -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Зарегистрироваться" Click="Register_Click"
                    HorizontalAlignment="Center" Width="220"/>

            <Button Grid.Column="2" Content="Назад" Click="Back_Click"
                    HorizontalAlignment="Right" Style="{StaticResource BtnSecondary}"/>
        </Grid>
    </Grid>
</Page>
