<Page x:Class="CleanPro.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход в систему — CleanPro">
    <!-- Страница входа: логотип, поля логин/пароль, сообщение об ошибке и кнопки внизу -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="360" Margin="20,20,20,0">
                <Image Source="/Images/logo.png" Height="88" Stretch="Uniform"
                       Margin="0,0,0,8"/>
                <TextBlock Text="CleanPro" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Клининговые услуги" HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedColor}"
                           Margin="0,0,0,22"/>

                <TextBlock Text="Вход в систему" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <TextBlock Text="Email, телефон или логин" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtLogin"/>

                <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="txtPassword"/>

                <TextBlock x:Name="txtError" Foreground="{StaticResource WarningColor}"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Margin="0,2,0,6"/>
            </StackPanel>
        </ScrollViewer>

        <!-- снизу: по центру вход, справа регистрация -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Войти" Click="Login_Click"
                    HorizontalAlignment="Center" Width="220"/>

            <Button Grid.Column="2" Content="Регистрация" Click="Register_Click"
                    HorizontalAlignment="Right" Style="{StaticResource BtnSecondary}"/>
        </Grid>
    </Grid>
</Page>
