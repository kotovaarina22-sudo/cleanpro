<Page x:Class="CleanPro.Pages.DataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Работа с данными — CleanPro">
    <!-- Админка: слева список таблиц, справа поиск, грид записей и кнопки управления -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- слева: список таблиц -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Таблицы базы данных"
                       FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
            <ListBox x:Name="navList" DisplayMemberPath="Title"
                     SelectionChanged="Nav_Changed"/>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <!-- сверху поиск -->
            <TextBox x:Name="txtSearch" Width="300" DockPanel.Dock="Top"
                     Margin="0,0,0,8"
                     TextChanged="Search_Changed" ToolTip="Поиск по таблице"/>

            <!-- снизу подпись, кнопки по центру и "В каталог" справа -->
            <StackPanel DockPanel.Dock="Bottom">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock x:Name="txtTitle" DockPanel.Dock="Left"
                               FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtHint" HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedColor}" VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnAdd" Content="Добавить" Click="Add_Click"/>
                        <Button x:Name="btnEdit" Content="Изменить" Click="Edit_Click"/>
                        <Button x:Name="btnDelete" Content="Удалить" Click="Delete_Click"
                                Style="{StaticResource BtnDanger}"/>
                    </StackPanel>

                    <Button x:Name="btnCatalog" Grid.Column="2" Content="В каталог"
                            Click="Catalog_Click" HorizontalAlignment="Right"
                            Style="{StaticResource BtnSecondary}"/>
                </Grid>
            </StackPanel>

            <DataGrid x:Name="grid" MouseDoubleClick="Grid_DoubleClick"/>
        </DockPanel>
    </Grid>
</Page>